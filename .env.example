# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ====== 应用自身地址 ======
# 生产填正式域名，例如 https://your-domain.com；PDF 渲染和分享链接会用到。
APP_BASE_URL=

# ====== AI 模型路由 (LLMRouter) ======
# 主推理模型（海外，价值验证阶段用）
ANTHROPIC_API_KEY=
# 兜底/未来合规切换（国产）
DEEPSEEK_API_KEY=
# 可选：OpenAI / OpenAI 兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 可选：火山方舟 / 豆包 OpenAI 兼容路由
ARK_API_KEY=
ARK_BASE_URL=
ARK_THINKING=

# 模型选择策略
# primary = anthropic | deepseek | openai | doubao
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-4-5-20250929
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-chat
# 可选：复盘截图识别。主模型为豆包/OPENAI且支持图片时可不填；否则显式指定。
LLM_VISION_PROVIDER=
LLM_VISION_MODEL=

# ====== 联网检索 ======
TAVILY_API_KEY=

# ====== 图片生成（增长封面）======
# IMAGE_PROVIDER = openai | volcengine
IMAGE_PROVIDER=openai
IMAGE_MODEL=
VOLCENGINE_AK=
VOLCENGINE_SK=
VOLCENGINE_JIMENG_REQ_KEY=

# ====== 短信登录（阿里云）======
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ====== 面霸君后台账号 ======
MIANBA_AUTH_SECRET=
MIANBA_ADMIN_ACCOUNT=admin
MIANBA_ADMIN_PASSWORD=
MIANBA_OPERATOR_ACCOUNT=operator
MIANBA_OPERATOR_PASSWORD=

# ====== 公开成本接口门禁 ======
# 生产环境下 /api/runs/*/generate 默认关闭公开调用；如确需外部调用，设置随机长 token。
RUN_GENERATION_TOKEN=

# ====== 快速打分（/quick/[panelId]/owner）======
# Owner 私用视图的密钥，自己设一串随机字符串；URL 形如 /quick/xuenian-30/owner?token=xxx
OWNER_VIEW_TOKEN=

# ====== PDF / 本地辅助 ======
# 本地没有系统 Chrome 时可指定；Vercel 通常使用 @sparticuz/chromium。
CHROME_PATH=

# 仅用于本地开发/测试，生产谨慎开启。
PRINCIPLESYOU_COLLECT_PATH=
GOLDEN_DEEP_FORCE_FIXTURE=
# 增长系统体验速度开关。遇到异常时可分别设为 false 快速回退，
# 不需要回滚数据库或内容数据。
GROWTH_LIGHT_BOOTSTRAP=true
GROWTH_PARALLEL_DRAFT_RACE=true
